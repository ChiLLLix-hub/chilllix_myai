# Local defaults. In Railway production, set these in the Railway dashboard instead of uploading a .env file.
PORT=3000
NODE_ENV=development
# Must exactly match the browser origin serving /public from cPanel, including https and subdomain.
FRONTEND_ORIGIN=https://frontend.example.com
DATABASE_URL=postgresql://username:password@localhost:5432/chilllix_myai?sslmode=disable
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret
# Required for real GPT Image 2 generation through Wiro.
WIRO_API_BASE_URL=https://api.wiro.ai/v1
WIRO_API_KEY=
# Required if you want S3-compatible cleanup/storage behavior in production.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL where generated assets should be reachable.
ASSET_BASE_URL=https://cdn.example.com/assets
AUTO_CLEANUP_ENABLED=true
ASSET_RETENTION_DAYS=7
CREDIT_COST_IMAGE=10
CREDIT_COST_VIDEO=35
CREDIT_COST_CHAT=3
STARTER_CREDITS=100
